PUID=1000
PGID=1000
BITRATE_KBPS=192
SAMPLE_RATE=44100
AUTO_SCAN_ON_START=true
AUTO_START_BROADCAST=true
SCAN_INTERVAL_HOURS=24
TZ=America/Chicago

# Local speech. "auto" uses Piper when a matching model is installed, then
# falls back to bundled eSpeak NG.
TTS_ENGINE=auto
DEFAULT_ESPEAK_VOICE=en-us
CONFIG_DIR=/config

# v0.2.0 AI DJ. qwen3:4b is the recommended default for a 16 GB Ollama host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_FAILURE_THRESHOLD=3
OLLAMA_CIRCUIT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m

# Generate programming ahead of live playback. LocalRadio fills the minimum
# first, then continues toward the target in small background batches.
SCHEDULE_MIN_HOURS=6
SCHEDULE_TARGET_HOURS=24
SCHEDULE_CHECK_SECONDS=60

# First-run seed / legacy migration only. Use the Station Builder afterward.
STATION_NAME=LocalRadio
STATION_ID=localradio
STATION_NUMBER=801
ARTIST_REPEAT_MINUTES=90
SONG_REPEAT_HOURS=12
MIN_YEAR=0
MAX_YEAR=0
ALLOWED_GENRES=
